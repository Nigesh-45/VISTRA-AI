# VISITR-AI Deployment Environment Overrides

# Configuration JSON Path
CONFIG_PATH=config.json

# Input Source Configuration
# INPUT_TYPE: "file" or "rtsp"
INPUT_TYPE=file
INPUT_SOURCE=data/sample_video.mp4

# RTSP Stream URL (Uncomment for live camera use)
# RTSP_URL=rtsp://admin:password@192.168.1.100:554/stream1

# Database Configuration
DATABASE_URL=sqlite:///database/visitors.db

# Engine Performance & Threshold Tuning
DETECTION_SKIP_FRAMES=5
SIMILARITY_THRESHOLD=0.45
EXIT_TIMEOUT_FRAMES=30

# Web Dashboard Configuration
HOST=0.0.0.0
PORT=8501
